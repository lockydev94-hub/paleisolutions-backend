# Application — Palei Solutions platform
APP_NAME=Palei Solutions
# CORS — comma-separated list of allowed origins (browser frontends)
# ALLOWED_ORIGINS=["https://paleisolutions.com","https://www.paleisolutions.com","https://admin.paleisolutions.com","https://paleiacservice.com","https://www.paleiacservice.com"]
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-here
API_V1_PREFIX=/api/v1

# Database — this platform's OWN local database.
# Local Postgres is exposed on 5433 by the repo-root docker-compose.yml.
DATABASE_URL=postgresql://palei_user:palei_pass@localhost:5433/palei_solutions

# Redis — logical DB 1 is reserved for Palei Solutions (Bibek uses 0)
REDIS_URL=redis://localhost:6379/1

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=palei-storage

# JWT
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# OTP
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6

# Razorpay
RAZORPAY_KEY_ID=your-key-id
RAZORPAY_KEY_SECRET=your-key-secret

# WhatsApp / SMS
SMS_API_KEY=your-sms-api-key
WHATSAPP_API_KEY=your-whatsapp-api-key

# Sentry
SENTRY_DSN=your-sentry-dsn

# Seeded super-admin — created on first boot if the email does not exist.
# Seeding is skipped when SEED_ADMIN_PASSWORD is empty. Use a unique, strong
# value per platform; this file is a template, never commit real credentials.
SEED_ADMIN_EMAIL=admin@paleisolutions.com
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
